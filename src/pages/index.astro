---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Peliculon.es — ¿Qué ver?"
  description="Descubre una película al azar con puntuación alta, sinopsis, reseñas y plataformas de streaming disponibles en España."
  canonical="https://peliculon.es/"
>
  <Fragment slot="head">
    <!-- is:global obliga a Astro a aplicar los estilos también al HTML inyectado por JS -->
    <style is:global>
      :root {
        --bg-color: #0b0510;
        --card-bg: rgba(23, 15, 42, 0.6);
        --text-main: #f8fafc;
        --text-muted: #cbd5e1;
        --accent-glow: rgba(139, 92, 246, 0.4);
        --primary-gradient: linear-gradient(135deg, #c084fc, #7c3aed);
        --secondary-bg: rgba(76, 29, 149, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      body {
        min-height: 100vh;
        background: radial-gradient(circle at top, #2e1065 0%, var(--bg-color) 60%);
        background-attachment: fixed;
        color: var(--text-main);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 40px 20px;
      }

      .site-header {
        text-align: center;
        margin-bottom: 24px;
        width: 100%;
        max-width: 1200px;
      }

      .site-title {
        font-family: 'Poppins', sans-serif;
        margin: 0;
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 4px 20px var(--accent-glow);
      }

      .site-subtitle {
        font-family: 'Poppins', sans-serif;
        margin: 8px 0 0 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .promo-text {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 32px auto;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .card {
        width: 100%;
        max-width: 1200px;
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* DISEÑO EN DOS COLUMNAS CON SEPARACIÓN AMPLIA */
      .row {
        display: grid;
        grid-template-columns: 380px minmax(0, 1fr);
        gap: 56px; /* Empuja todo el bloque derecho lejos de la imagen */
        align-items: start;
        width: 100%;
      }

      /* CONTENEDOR DE LA IMAGEN CON RECORTE DE SEGURIDAD */
      .poster {
        width: 380px;
        max-width: 100%;
        border-radius: 16px;
        overflow: hidden; /* Garantiza que nada salga de los 380px ni pierda el borde curvo */
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.65);
        background: rgba(0, 0, 0, 0.25);
        display: block;
      }

      .poster img {
        width: 100% !important;
        max-width: 100% !important;
        height: auto !important;
        display: block !important;
        border-radius: 16px !important;
        transition: transform 0.3s ease;
      }

      .card:hover .poster img {
        transform: scale(1.02);
      }

      /* COLUMNA DERECHA (TEXTOS, ICONOS Y BOTONES) */
      .meta {
        display: flex;
        flex-direction: column;
        width: 100%;
        min-width: 0;
      }

      #title {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 12px 0;
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.2;
        color: #ffffff;
      }

      #sub {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }

      .badge {
        background: rgba(255, 255, 255, 0.1);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      
      .badge.star {
        background: rgba(234, 179, 8, 0.15);
        color: #fde047;
        border-color: rgba(234, 179, 8, 0.3);
      }

      .synopsis-intro {
        font-size: 1rem;
        color: #c084fc;
        margin-bottom: 10px;
        font-weight: 600;
      }

      #overview {
        max-height: 380px;
        overflow-y: auto;
        color: #e2e8f0;
        line-height: 1.7;
        font-size: 1.1rem;
        margin-bottom: 20px;
        padding-right: 15px;
      }

      #overview::-webkit-scrollbar {
        width: 6px;
      }
      #overview::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
      }
      #overview::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
      }

      .review {
        margin-top: 12px;
        padding: 16px;
        background: rgba(0, 0, 0, 0.2);
        border-left: 4px solid #8b5cf6;
        border-radius: 8px;
        color: #f8fafc;
      }

      .review .review-content {
        font-size: 0.95rem;
        line-height: 1.5;
        font-style: italic;
      }

      .review .review-author {
        margin-top: 10px;
        color: #c084fc;
        font-weight: 600;
        font-size: 0.9rem;
        text-align: right;
      }

      .review-separator {
        border: 0;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        margin: 16px 0;
      }

      #watchProviders {
        margin: 24px 0;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        width: 100%;
      }

      .providers-title {
        margin: 0 0 12px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #cbd5e1;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .provider-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .provider-list li {
        width: 42px;
        height: 42px;
        overflow: hidden;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
      }

      .provider-list img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .controls {
        display: flex;
        gap: 16px;
        margin-top: auto;
        padding-top: 24px;
      }

      button {
        font-family: 'Inter', sans-serif;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      #anotherBtn {
        padding: 14px 28px;
        font-size: 1.1rem;
        background: var(--primary-gradient);
        color: #ffffff;
        box-shadow: 0 4px 15px var(--accent-glow);
        flex: 1;
      }

      #anotherBtn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px var(--accent-glow);
        filter: brightness(1.1);
      }

      button.secondary {
        background: var(--secondary-bg);
        color: var(--text-main);
        padding: 12px 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      button.secondary:hover:not(:disabled) {
        background: rgba(139, 92, 246, 0.4);
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
      }

      button[aria-disabled="true"] {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }

      button:focus-visible,
      a:focus-visible {
        outline-color: #f0abfc;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link:focus {
        position: fixed;
        z-index: 10;
        top: 16px;
        left: 16px;
        width: auto;
        height: auto;
        padding: 12px 16px;
        margin: 0;
        clip: auto;
        overflow: visible;
        white-space: normal;
        border-radius: 8px;
        background: #fff;
        color: #170f2a;
        font-weight: 600;
      }

      :focus-visible {
        outline: 3px solid #f0abfc;
        outline-offset: 3px;
      }

      .small {
        font-size: 0.95rem;
        color: var(--text-muted);
      }

      footer {
        text-align: center;
        padding: 32px 20px;
        margin-top: auto;
        color: var(--text-muted);
      }

      footer a {
        color: #c084fc;
        text-decoration: none;
        margin: 0 15px;
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      footer a:hover {
        color: #e9d5ff;
        text-decoration: underline;
      }

      @media (max-width: 950px) {
        .row {
          grid-template-columns: 1fr;
          gap: 32px;
        }
        
        .poster {
          width: 100%;
          max-width: 340px;
          margin: 0 auto;
        }

        #title {
          text-align: center;
          font-size: 2rem;
        }

        #sub {
          justify-content: center;
        }

        #overview {
          text-align: center;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }

      @media (max-width: 600px) {
        body {
          padding: 20px 12px;
        }

        .site-title {
          font-size: 2.5rem;
        }

        .card {
          padding: 24px;
        }

        .poster {
          max-width: 100%;
        }

        .controls {
          flex-direction: column-reverse;
        }

        button {
          width: 100%;
          padding: 16px;
        }
        
        #anotherBtn {
          font-size: 1.15rem;
        }
      }
    </style>
    <meta name="google-adsense-account" content="ca-pub-5799986250497785" />
  </Fragment>
    <header class="site-header">
      <a class="skip-link sr-only" href="#main">Saltar al contenido principal</a>
      <h1 class="site-title">Peliculon.es</h1>
      <h2 class="site-subtitle">¿No sabes qué película ver?</h2>
    </header>

    <p class="promo-text">
      Descubre una película bien valorada sin recorrer listas interminables. Cada recomendación incluye su sinopsis y, cuando TMDB dispone de ellos, reseñas y plataformas de streaming en España.
    </p>

    <main id="main" class="card" aria-labelledby="title" aria-busy="false">
      <div class="row">
        <div class="poster" id="poster" aria-label="Póster de la película">Cargando...</div>
        
        <div class="meta">
          <h2 id="title">Cargando...</h2>
          
          <div id="sub">
          </div>
          
          <div class="synopsis-intro" id="synopsisIntro" hidden>De qué trata este peliculón:</div>
          <div id="overview">
            Haz clic en <strong>Otra película</strong> para obtener una sugerencia perfecta para hoy.
          </div>

          <div id="watchProviders" hidden></div>

          <div>
            <button
              id="showReviewBtn"
              class="secondary"
              type="button"
              hidden
              aria-controls="review"
              aria-expanded="false"
              style="margin-bottom: 10px; width: auto; padding: 8px 16px; font-size: 0.85rem;"
            >
              Mostrar reseña
            </button>
          </div>

          <div id="review" class="review" hidden></div>

          <div>
            <button
              id="showEngBtn"
              class="secondary"
              type="button"
              hidden
              aria-controls="engReviews"
              aria-expanded="false"
              style="margin-top: 10px; width: auto; padding: 8px 16px; font-size: 0.85rem;"
            >
              Ver reseñas en Inglés
            </button>
          </div>

          <div id="engReviews" class="review" hidden></div>
          <div id="status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

          <div class="controls">
            <button id="prevBtn" class="secondary" type="button" aria-disabled="true">Anterior</button>
            <button id="anotherBtn" type="button">🎬 Otra película</button>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div style="font-size: 0.75rem; margin-top: 15px; opacity: 0.5;">Datos proporcionados por TMDB</div>
    </footer>

    <script>
      import { initMovieRecommendations } from "../scripts/movie-recommendations";

      initMovieRecommendations();
    </script>
</SiteLayout>