<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Peliculon.es — ¿Qué ver?</title>
    <meta
      name="description"
      content="Peliculon.es sugiere películas y peliculones para ver cuando no sabes qué ver. Pulsa 'Otra película' para obtener una recomendación aleatoria con sinopsis y reseñas."
    />
    <meta property="og:site_name" content="Peliculon.es" />
    <meta property="og:title" content="Peliculon.es — ¿Qué ver?" />
    <meta
      property="og:description"
      content="¿No sabes qué ver? Obtén una recomendación de qué pelicula ver aleatoriamente."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/og-default.png" />
    <link rel="canonical" href="https://peliculon.es/" />
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --bg-color: #0b0510;
        --card-bg: rgba(23, 15, 42, 0.6);
        --text-main: #f8fafc;
        --text-muted: #cbd5e1;
        --accent-glow: rgba(139, 92, 246, 0.4);
        --primary-gradient: linear-gradient(135deg, #c084fc, #7c3aed);
        --secondary-bg: rgba(76, 29, 149, 0.3);
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        background: radial-gradient(circle at top, #2e1065 0%, var(--bg-color) 60%);
        background-attachment: fixed;
        color: var(--text-main);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        padding: 40px 20px;
      }

      .site-header {
        text-align: center;
        margin-bottom: 24px;
        width: 100%;
        max-width: 1000px;
      }

      .site-title {
        font-family: 'Poppins', sans-serif;
        margin: 0;
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -1px;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 4px 20px var(--accent-glow);
      }

      .site-subtitle {
        font-family: 'Poppins', sans-serif;
        margin: 8px 0 0 0;
        font-size: 1.1rem;
        font-weight: 600;
        color: #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .promo-text {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 32px auto;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--text-muted);
      }

      .card {
        width: 100%;
        max-width: 1000px;
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 32px;
        border-radius: 20px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .row {
        display: flex;
        gap: 32px;
        align-items: flex-start; 
      }

      /* LA SOLUCIÓN DEL PÓSTER: Caja totalmente estricta y blindada */
      .poster {
        width: 300px;
        flex: 0 0 300px; /* Evita que crezca o se encoja */
        aspect-ratio: 2 / 3; /* Forzamos la proporción real de los pósters */
        border-radius: 12px;
        overflow: hidden; /* Esto es clave: nada puede salirse de la caja */
        background: rgba(0, 0, 0, 0.4);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        position: relative;
      }

      .poster img {
        width: 100%;
        height: 100%;
        object-fit: contain; /* Garantiza que la imagen entera sea visible sin recortes */
        display: block;
        transition: transform 0.3s ease;
      }

      .card:hover .poster img {
        transform: scale(1.03);
      }

      .meta {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      #title {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 12px 0;
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1.2;
        color: #ffffff;
      }

      #sub {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }

      .badge {
        background: rgba(255, 255, 255, 0.1);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      
      .badge.star {
        background: rgba(234, 179, 8, 0.15);
        color: #fde047;
        border-color: rgba(234, 179, 8, 0.3);
      }

      .synopsis-intro {
        font-size: 1rem;
        color: #c084fc;
        margin-bottom: 10px;
        font-weight: 600;
      }

      #overview {
        max-height: 250px;
        overflow-y: auto;
        color: #e2e8f0;
        line-height: 1.6;
        font-size: 1.05rem;
        margin-bottom: 20px;
        padding-right: 10px;
      }

      #overview::-webkit-scrollbar {
        width: 6px;
      }
      #overview::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
      }
      #overview::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
      }

      .review {
        margin-top: 12px;
        padding: 16px;
        background: rgba(0, 0, 0, 0.2);
        border-left: 4px solid #8b5cf6;
        border-radius: 8px;
        color: #f8fafc;
      }

      .review .review-content {
        font-size: 0.95rem;
        line-height: 1.5;
        font-style: italic;
      }

      .review .review-author {
        margin-top: 10px;
        color: #c084fc;
        font-weight: 600;
        font-size: 0.9rem;
        text-align: right;
      }

      #watchProviders {
        margin: 24px 0;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        width: 100%;
      }

      .providers-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #cbd5e1;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
      }

      .controls {
        display: flex;
        gap: 16px;
        margin-top: auto;
        padding-top: 20px;
      }

      button {
        font-family: 'Inter', sans-serif;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      #anotherBtn {
        padding: 14px 28px;
        font-size: 1.1rem;
        background: var(--primary-gradient);
        color: #ffffff;
        box-shadow: 0 4px 15px var(--accent-glow);
        flex: 1;
      }

      #anotherBtn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px var(--accent-glow);
        filter: brightness(1.1);
      }

      button.secondary {
        background: var(--secondary-bg);
        color: var(--text-main);
        padding: 12px 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }

      button.secondary:hover:not(:disabled) {
        background: rgba(139, 92, 246, 0.4);
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
        box-shadow: none !important;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0,0,0,0);
        white-space: nowrap;
        border: 0;
      }

      .small {
        font-size: 0.95rem;
        color: var(--text-muted);
      }

      footer {
        text-align: center;
        padding: 32px 20px;
        margin-top: auto;
        color: var(--text-muted);
      }

      footer a {
        color: #c084fc;
        text-decoration: none;
        margin: 0 15px;
        font-size: 0.95rem;
        transition: color 0.2s;
      }

      footer a:hover {
        color: #e9d5ff;
        text-decoration: underline;
      }

      @media (max-width: 900px) {
        .row {
          flex-direction: column;
          align-items: center;
          gap: 24px;
        }
        
        .poster {
          width: 100%;
          max-width: 280px;
          flex: auto; /* Permite que el póster se encoja en móviles */
        }

        #title {
          text-align: center;
          font-size: 1.8rem;
        }

        #sub {
          justify-content: center;
        }

        #overview {
          text-align: center;
        }
      }

      @media (max-width: 600px) {
        body {
          padding: 20px 12px;
        }

        .site-title {
          font-size: 2.5rem;
        }

        .card {
          padding: 20px;
        }

        .controls {
          flex-direction: column-reverse;
        }

        button {
          width: 100%;
          padding: 16px;
        }
        
        #anotherBtn {
          font-size: 1.15rem;
        }
      }
    </style>
    <meta name="google-adsense-account" content="ca-pub-5799986250497785" />
  </head>
  <body>
    <header class="site-header">
      <a class="skip-link sr-only" href="#main">Saltar al contenido</a>
      <h1 class="site-title">Peliculon.es</h1>
      <h2 class="site-subtitle">¿No sabes qué película ver?</h2>
    </header>

    <div class="promo-text">
      Olvídate de listas interminables. Te damos el peliculón de la noche y su sinopsis en un solo clic. Nuestra misión es simple: menos buscar, más ver.
    </div>

    <main id="main" class="card">
      <div class="row">
        <div class="poster" id="poster">Cargando...</div>
        
        <div class="meta">
          <h2 id="title">Cargando...</h2>
          
          <div id="sub">
          </div>
          
          <div class="synopsis-intro" id="synopsisIntro" hidden>De qué trata este peliculón:</div>
          <div id="overview">
            Haz clic en <strong>Otra película</strong> para obtener una sugerencia perfecta para hoy.
          </div>

          <div id="watchProviders" hidden></div>

          <div>
            <button
              id="showReviewBtn"
              class="secondary"
              hidden
              aria-controls="review"
              aria-expanded="false"
              style="margin-bottom: 10px; width: auto; padding: 8px 16px; font-size: 0.85rem;"
            >
              Mostrar reseña
            </button>
          </div>

          <div id="review" class="review" hidden></div>

          <div>
            <button
              id="showEngBtn"
              class="secondary"
              hidden
              aria-controls="engReviews"
              aria-expanded="false"
              style="margin-top: 10px; width: auto; padding: 8px 16px; font-size: 0.85rem;"
            >
              Ver reseñas en Inglés
            </button>
          </div>

          <div id="engReviews" class="review" hidden></div>
          <div id="status" class="sr-only" aria-live="polite"></div>

          <div class="controls">
            <button id="prevBtn" class="secondary" disabled>Anterior</button>
            <button id="anotherBtn">🎬 Otra película</button>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <a href="/privacidad">Política de Privacidad</a>
      <a href="/contacto">Contacto</a>
      <div style="font-size: 0.75rem; margin-top: 15px; opacity: 0.5;">Datos proporcionados por TMDB</div>
    </footer>

    <script type="module">
      const posterEl = document.getElementById("poster");
      const titleEl = document.getElementById("title");
      const overviewEl = document.getElementById("overview");
      const synopsisIntroEl = document.getElementById("synopsisIntro");
      const reviewEl = document.getElementById("review");
      const showReviewBtn = document.getElementById("showReviewBtn");
      const showEngBtn = document.getElementById("showEngBtn");
      const engReviews = document.getElementById("engReviews");
      const subEl = document.getElementById("sub");
      const prevBtn = document.getElementById("prevBtn");
      const anotherBtn = document.getElementById("anotherBtn");
      const statusEl = document.getElementById("status");
      const watchProvidersEl = document.getElementById("watchProviders");

      let history = [];
      let index = -1;

      function updateMeta(movie) {
        try {
          document.title = "Peliculon.es — ¿Qué ver?";

          const metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc)
            metaDesc.setAttribute(
              "content",
              (movie && movie.overview) ||
                "Peliculon.es — recomendación de películas"
            );

          const ogTitle = document.querySelector('meta[property="og:title"]');
          if (ogTitle)
            ogTitle.setAttribute("content", "Peliculon.es — ¿Qué ver?");

          const ogDesc = document.querySelector(
            'meta[property="og:description"]'
          );
          if (ogDesc)
            ogDesc.setAttribute(
              "content",
              (movie && movie.overview) ||
                "Peliculon.es — recomendación de películas"
            );

          const ogImage = document.querySelector('meta[property="og:image"]');
          if (ogImage && movie && movie.poster_path)
            ogImage.setAttribute("content", movie.poster_path);

          const twTitle = document.querySelector('meta[name="twitter:title"]');
          if (twTitle)
            twTitle.setAttribute("content", "Peliculon.es — ¿Qué ver?");
          const twDesc = document.querySelector(
            'meta[name="twitter:description"]'
          );
          if (twDesc)
            twDesc.setAttribute(
              "content",
              (movie && movie.overview) ||
                "Peliculon.es — recomendación de películas"
            );
          const twImage = document.querySelector('meta[name="twitter:image"]');
          if (twImage && movie && movie.poster_path)
            twImage.setAttribute("content", movie.poster_path);

          const ogUrl = document.querySelector('meta[property="og:url"]');
          if (ogUrl) ogUrl.setAttribute("content", window.location.href);
        } catch (e) {
          console.warn("updateMeta failed", e);
        }
      }

      function render(movie) {
        try {
          if (!movie) return;
          updateMeta(movie);
          const formattedDate = movie.release_date
            ? formatDate(movie.release_date)
            : "";
          const titleText =
            movie.title || movie.name || movie.original_title || "Sin título";
          const overviewText =
            movie.overview || movie.synopsis || "Descripción no disponible.";

          if (titleEl) titleEl.textContent = titleText;
          if (overviewEl) overviewEl.textContent = overviewText;
          if (synopsisIntroEl && movie.overview) synopsisIntroEl.hidden = false;

          subEl.innerHTML = [
            formattedDate
              ? `<span class="badge">📅 <time datetime="${movie.release_date}">${formattedDate}</time></span>`
              : null,
            movie.vote_average 
              ? `<span class="badge star">⭐ ${movie.vote_average.toFixed(1)}</span>` 
              : null,
          ].filter(Boolean).join("");

          if (movie.poster_path) {
            posterEl.innerHTML = `<img src="${movie.poster_path}" alt="Póster de ${escapeHtml(movie.title)}">`;
          } else {
            posterEl.innerHTML = "<span style='color: #475569;'>Sin póster</span>";
          }

          if (movie.review_content) {
            showReviewBtn.hidden = false;
            showEngBtn.hidden = true;
            engReviews.hidden = true;
            engReviews.innerHTML = "";
            reviewEl.hidden = true;
            showReviewBtn.textContent = "Mostrar reseña";
            const author = movie.review_author
              ? `— ${escapeHtml(movie.review_author)}`
              : "";
            reviewEl.innerHTML = `<div class="review-content">"${escapeHtml(movie.review_content)}"</div>${author ? `<div class="review-author">${author}</div>` : ""}`;
            if (statusEl)
              statusEl.textContent = `Sugerencia: ${movie.title || "película"}`;
            try {
              titleEl.setAttribute("tabindex", "-1");
              titleEl.focus({ preventScroll: true });
            } catch (e) {}
          } else {
            showReviewBtn.hidden = true;
            reviewEl.hidden = false;
            reviewEl.innerHTML = `<div class="small">No se encontraron reseñas en Español</div>`;
            if (movie.english_reviews && movie.english_reviews.length) {
              showEngBtn.hidden = false;
              engReviews.hidden = true;
              showEngBtn.textContent = "Ver reseñas en Inglés";
              engReviews.innerHTML = movie.english_reviews
                .map(
                  (r) =>
                    `<div class="review-content">"${escapeHtml(r.content || "")}"</div>${r.author ? `<div class="review-author">— ${escapeHtml(r.author)}</div>` : ""}`
                )
                .join(
                  '<hr style="border:none;border-top:1px solid rgba(255,255,255,0.04);margin:16px 0">'
                );
              if (statusEl)
                statusEl.textContent = `No se encontraron reseñas en Español. ${movie.english_reviews.length} reseña(s) en Inglés disponible(s).`;
            } else {
              showEngBtn.hidden = true;
              engReviews.hidden = true;
              engReviews.innerHTML = "";
            }
          }

          if (watchProvidersEl) {
            if (movie.watch_providers && movie.watch_providers.length > 0) {
              watchProvidersEl.innerHTML = `
                <div class="providers-title">Disponible en:</div>
                <div style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: flex-start; width: 100%;">
                  ${movie.watch_providers
                    .map(
                      (provider) => `
                    <div title="${escapeHtml(provider.name || "")}" style="width: 42px; height: 42px; flex: 0 0 42px; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.4); background: #fff; margin: 0; padding: 0; display: block;">
                      <img src="${escapeHtml(provider.logo || "")}" alt="${escapeHtml(provider.name || "")}" style="width: 100% !important; height: 100% !important; object-fit: contain !important; display: block !important; margin: 0 !important; padding: 0 !important; border: none !important; border-radius: 0 !important;">
                    </div>
                  `
                    )
                    .join("")}
                </div>
              `;
              watchProvidersEl.hidden = false;
            } else {
              watchProvidersEl.innerHTML = "";
              watchProvidersEl.hidden = true;
            }
          }

          prevBtn.disabled = index <= 0;
        } catch (e) {
          console.warn("[render] failed", e);
        }
      }

      function formatDate(d) {
        if (!d) return "";
        const isoMatch = /^\s*(\d{4})-(\d{2})-(\d{2})\s*$/.exec(d);
        if (isoMatch) {
          const [, y, m, day] = isoMatch;
          return `${day}/${m}/${y}`;
        }
        const dt = new Date(d);
        if (isNaN(dt)) return d;
        const dd = String(dt.getDate()).padStart(2, "0");
        const mm = String(dt.getMonth() + 1).padStart(2, "0");
        const yyyy = dt.getFullYear();
        return `${dd}/${mm}/${yyyy}`;
      }

      function escapeHtml(s) {
        return String(s).replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c]
        );
      }

      async function fetchRandom() {
        anotherBtn.disabled = true;
        anotherBtn.innerHTML = "⏳ Buscando...";
        if (statusEl) statusEl.textContent = "Cargando sugerencia...";
        try {
          const res = await fetch("/api/random");
          if (!res.ok) throw new Error("Solicitud fallida");
          const movie = await res.json();
          if (movie.error) throw new Error(movie.error);
          if (index < history.length - 1) history = history.slice(0, index + 1);
          history.push(movie);
          index = history.length - 1;
          render(movie);
        } catch (err) {
          titleEl.textContent = "¡Ups! Ha ocurrido un error";
          overviewEl.textContent =
            err.message || "Error al obtener la película. Inténtalo de nuevo.";
          posterEl.innerHTML = "<span style='color: #475569;'>Sin póster</span>";
        } finally {
          anotherBtn.disabled = false;
          anotherBtn.innerHTML = "🎬 Otra película";
        }
      }

      prevBtn.addEventListener("click", () => {
        if (index > 0) {
          index -= 1;
          render(history[index]);
        }
      });

      anotherBtn.addEventListener("click", fetchRandom);

      showReviewBtn.addEventListener("click", () => {
        if (reviewEl.hidden) {
          reviewEl.hidden = false;
          showReviewBtn.textContent = "Ocultar reseña";
          showReviewBtn.setAttribute("aria-expanded", "true");
        } else {
          reviewEl.hidden = true;
          showReviewBtn.textContent = "Mostrar reseña";
          showReviewBtn.setAttribute("aria-expanded", "false");
        }
      });

      showEngBtn.addEventListener("click", () => {
        if (engReviews.hidden) {
          engReviews.hidden = false;
          showEngBtn.textContent = "Ocultar reseñas en Inglés";
          showEngBtn.setAttribute("aria-expanded", "true");
        } else {
          engReviews.hidden = true;
          showEngBtn.textContent = "Ver reseñas en Inglés";
          showEngBtn.setAttribute("aria-expanded", "false");
        }
      });

      fetchRandom();
    </script>
  </body>
</html>